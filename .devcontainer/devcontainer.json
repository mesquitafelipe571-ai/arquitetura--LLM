{
  "name": "arquitetura--LLM / Orca",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "remoteUser": "node",
  "containerEnv": {
    "ORCA_PNPM_GLOBAL_VIRTUAL_STORE": "0"
  },
  "runArgs": [
    "--shm-size=1g"
  ],
  "forwardPorts": [
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "Desktop do Orca",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm run orca:setup",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  }
}
